# Copy to .env and fill in. Never commit .env.

# local | testing | production
APP_ENV=production
APP_DEBUG=false
# Sub-directory the app is served from, if any (e.g. /spms). Empty when it has its own host.
APP_BASE_PATH=
APP_TIMEZONE=Asia/Jerusalem
# Default interface language: he | ar
APP_LOCALE=he

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spms
DB_USERNAME=
DB_PASSWORD=

# Session cookie is sent over HTTPS only. Set to false ONLY for local development over http.
SESSION_SECURE=true
SESSION_IDLE_MINUTES=30

UPLOAD_MAX_MB=10

# Ceilings per signed-in session, per minute.
RATE_LIMIT_WRITES=120
RATE_LIMIT_EXPORTS=20

# Encrypted backups (bin/console backup). At least 24 random characters. Keep a copy OUTSIDE the server:
# without it the backups cannot be opened.
BACKUP_KEY=
BACKUP_KEEP_DAYS=30
# Full paths when the MySQL client tools are not on the PATH (e.g. C:/xampp/mysql/bin/mysqldump.exe).
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

# Local demo data only (bin/console seed:demo). Leave empty to have one generated.
DEMO_PASSWORD=

# Sign-in through the Ministry of Education (OpenID Connect). Off until the school is registered with the
# Ministry as an approved application and receives these values. The password is typed only on the
# Ministry's page. Users link their account once (account page → "link"), while signed in.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Register exactly this address with the provider, e.g. https://spms.example.org.il/auth/sso/callback
SSO_REDIRECT_URI=
SSO_SCOPES=openid
# The ID-token claim that identifies the person (from the provider's documentation).
SSO_ID_CLAIM=sub
# Key of the stored fingerprint of that identifier: at least 24 random characters. Keep a copy like BACKUP_KEY –
# changing it unlinks every account.
SSO_HASH_KEY=
SSO_LABEL_HE=כניסה דרך משרד החינוך
SSO_LABEL_AR=الدخول عبر وزارة التربية والتعليم

# Online lessons through a LiveKit media server (see docs/online-lessons.md). Off until filled.
# Production: wss:// address of your LiveKit server, and a key/secret pair from its configuration.
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_MINUTES=120
